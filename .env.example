# Copy to .env and fill in at least one key.
# If more than one key is set, `pnpm dev` asks which provider to use for the session.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override the default model for a provider.
# ANTHROPIC_MODEL=
# OPENAI_MODEL=
# GOOGLE_MODEL=

# Optional: port for the local API server (default 8787).
# SURFACE_API_PORT=8787
